# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file - the webhook URL is a secret.

# Required: your Discord webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Optional: force a specific log file (leave empty for auto-detection)
MINECRAFT_LOG_PATH=

# Optional: your Discord user id, to get pinged on drops worth >= 1M coins
PING_USER_ID=

# Only notify when the estimated value is at least this many coins.
# 0 = everything (spammy: Enchanted Spider Eye is ~1.3k).
# 500000 = skips the usual slayer/mob junk, keeps Fly Swatter-tier and up.
MIN_VALUE_COINS=500000

# What to do when no price can be found (new item, not on Bazaar or AH).
# true = notify anyway, false = stay quiet.
NOTIFY_UNKNOWN_VALUE=true

# Never notify about these, whatever they are worth. Comma-separated names.
IGNORE_ITEMS=Enchanted Spider Eye, Tarantula Web, Digested Mushrooms

# Optional tuning
POLL_INTERVAL_SECONDS=1.0
PRICE_CACHE_SECONDS=600

# Discord POST retries. A transient "Connection aborted" no longer drops a drop;
# it retries with exponential backoff (base, base*2, base*4, ... up to the cap).
DISCORD_MAX_ATTEMPTS=5
DISCORD_BACKOFF_SECONDS=2
DISCORD_BACKOFF_CAP_SECONDS=30

# Optional: auction-house price API ({id} = Skyblock item id). Empty = Bazaar only.
AUCTION_PRICE_URL=https://sky.coflnet.com/api/item/price/{id}/bin

# --- Auction house alerts -------------------------------------------------
# Separate webhook so sales do not mix with drop alerts. Empty = use the main one.
AUCTION_WEBHOOK_URL=
AUCTION_ALERTS=true
# Collecting a full mailbox fires many lines at once; they are gathered into a
# single embed after this many quiet seconds.
AUCTION_BATCH_SECONDS=6
